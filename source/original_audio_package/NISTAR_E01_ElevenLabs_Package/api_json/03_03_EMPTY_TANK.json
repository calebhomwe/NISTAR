[
  {
    "line_id": "E01_S03_L001",
    "speaker_id": "ren",
    "text": "[quietly] At least you don't complain."
  },
  {
    "line_id": "E01_S03_L002",
    "speaker_id": "ren",
    "text": "[under his breath] I always make it."
  },
  {
    "line_id": "E01_S03_L003",
    "speaker_id": "ren_vo",
    "text": "Sato only calls when money is moving."
  },
  {
    "line_id": "E01_S03_L004",
    "speaker_id": "ren_vo",
    "text": "Money moves when someone is afraid."
  },
  {
    "line_id": "E01_S03_L005",
    "speaker_id": "ren_vo",
    "text": "Tonight, somebody is afraid."
  },
  {
    "line_id": "E01_S03_L006",
    "speaker_id": "ren_vo",
    "text": "[dismissive] I'll eat afterwards."
  }
]