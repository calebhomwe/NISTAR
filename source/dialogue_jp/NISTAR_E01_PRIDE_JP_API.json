[
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L001", "speaker_id": "scripture", "text": "高慢は破滅に先立ち、傲慢は崩壊に先立つ。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L002", "speaker_id": "ren_vo", "text": "ルールが必要な奴がいる。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L003", "speaker_id": "ren_vo", "text": "警告標識が必要な奴が。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L004", "speaker_id": "ren_vo", "text": "ブレーキが必要な奴が。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L005", "speaker_id": "ren_vo", "text": "俺は、そのどれでもなかった。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L006", "speaker_id": "ren", "text": "俺はいつだって、切り抜ける。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L007", "speaker_id": "ren_vo", "text": "世界は、止まろうとしない奴のために回ってる。" },
  { "scene": "01_COLD_OPEN_DREAM", "line_id": "E01_S01_L008", "speaker_id": "the_voice", "text": "誰が告げた——お前が運転していると。" },

  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L001", "speaker_id": "daisuke", "text": "イエス様……" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L002", "speaker_id": "daisuke", "text": "息子が、どこにいるのか……俺には分からない。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L003", "speaker_id": "daisuke", "text": "だが、あなたはご存知だ。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L004", "speaker_id": "daisuke", "text": "あいつが“強さ”と呼ぶ、あの嘘に……あいつを、殺させないでください。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L005", "speaker_id": "ren", "text": "——ッ、はっ……!" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L006", "speaker_id": "ren", "text": "……ああ。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L007", "speaker_id": "sato", "text": "遅い。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L008", "speaker_id": "ren", "text": "家にいる。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L009", "speaker_id": "sato", "text": "もう、違う。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L010", "speaker_id": "ren", "text": "何があった?" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L011", "speaker_id": "sato", "text": "まず来い。話はそれからだ。" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L012", "speaker_id": "ren", "text": "サトウ——" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L013", "speaker_id": "sato", "text": "それと、レン?" },
  { "scene": "02_PRISON_PRAYER_AND_AWAKENING", "line_id": "E01_S02_L014", "speaker_id": "sato", "text": "電話が鳴る前から、お前はもう遅れていた。" },

  { "scene": "03_EMPTY_TANK", "line_id": "E01_S03_L001", "speaker_id": "ren", "text": "お前は、文句を言わないだけマシだ。" },
  { "scene": "03_EMPTY_TANK", "line_id": "E01_S03_L002", "speaker_id": "ren", "text": "俺はいつだって、切り抜ける。" },
  { "scene": "03_EMPTY_TANK", "line_id": "E01_S03_L003", "speaker_id": "ren_vo", "text": "サトウが電話してくるのは、金が動く時だけだ。" },
  { "scene": "03_EMPTY_TANK", "line_id": "E01_S03_L004", "speaker_id": "ren_vo", "text": "金が動くのは、誰かが怯えてる時だ。" },
  { "scene": "03_EMPTY_TANK", "line_id": "E01_S03_L005", "speaker_id": "ren_vo", "text": "今夜、誰かが怯えてる。" },
  { "scene": "03_EMPTY_TANK", "line_id": "E01_S03_L006", "speaker_id": "ren_vo", "text": "飯は、後でいい。" },

  { "scene": "04_REINA_SENSES_THE_PRAYER", "line_id": "E01_S04_L001", "speaker_id": "associate", "text": "今のは、あいつか?" },
  { "scene": "04_REINA_SENSES_THE_PRAYER", "line_id": "E01_S04_L002", "speaker_id": "reina", "text": "いいえ。" },
  { "scene": "04_REINA_SENSES_THE_PRAYER", "line_id": "E01_S04_L003", "speaker_id": "reina", "text": "何かが、あの子に手を伸ばしたのよ。" },
  { "scene": "04_REINA_SENSES_THE_PRAYER", "line_id": "E01_S04_L004", "speaker_id": "associate", "text": "あんたの手の者か?" },
  { "scene": "04_REINA_SENSES_THE_PRAYER", "line_id": "E01_S04_L005", "speaker_id": "reina", "text": "わたくしの手の者は、祈ったりしないわ。" },
  { "scene": "04_REINA_SENSES_THE_PRAYER", "line_id": "E01_S04_L006", "speaker_id": "reina", "text": "誰がしたのか、調べなさい。" },

  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L001", "speaker_id": "ren", "text": "どけ。" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L002", "speaker_id": "ren", "text": "くそっ——!" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L003", "speaker_id": "ren", "text": "な……なんだ——?" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L004", "speaker_id": "guardian", "text": "……また、か。" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L005", "speaker_id": "ren", "text": "……ふっ。まだ、いけるじゃねえか。" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L006", "speaker_id": "daisuke", "text": "……ありがとう、ございます。" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L007", "speaker_id": "reflection", "text": "逃げろ。" },
  { "scene": "05_THE_INTERVENTION", "line_id": "E01_S05_L008", "speaker_id": "ren", "text": "そんなに、見せ物が見たいか?" },

  { "scene": "06_THE_CHASE", "line_id": "E01_S06_L001", "speaker_id": "ren", "text": "お前ら、揃いも揃って遅すぎる。" },
  { "scene": "06_THE_CHASE", "line_id": "E01_S06_L002", "speaker_id": "ren", "text": "俺を捕まえられるもんか!" },
  { "scene": "06_THE_CHASE", "line_id": "E01_S06_L003", "speaker_id": "ren", "text": "今夜だけは、そうはいかない。" },

  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L001", "speaker_id": "sato", "text": "遅い。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L002", "speaker_id": "ren", "text": "もう、来てる。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L003", "speaker_id": "sato", "text": "責めてるのは、そこじゃない。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L004", "speaker_id": "ren", "text": "なんだ、それ?" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L005", "speaker_id": "sato", "text": "タンクだ。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L006", "speaker_id": "ren", "text": "タンク?" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L007", "speaker_id": "sato", "text": "逃げ出した。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L008", "speaker_id": "ren", "text": "犬一匹のために、街の反対側から呼び出したのか?" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L009", "speaker_id": "sato", "text": "いなくなったから、呼んだ。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L010", "speaker_id": "ren", "text": "後ろに、警察がついてたんだぞ。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L011", "speaker_id": "sato", "text": "ああ。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L012", "speaker_id": "sato", "text": "まるで神にでも追われてるみたいに、街を半分も突っ切ってきた。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L013", "speaker_id": "sato", "text": "……犬一匹のために。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L014", "speaker_id": "ren", "text": "緊急だって、言ったじゃないか。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L015", "speaker_id": "sato", "text": "俺には、緊急だった。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L016", "speaker_id": "sato", "text": "お前の問題は、遅刻じゃない。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L017", "speaker_id": "sato", "text": "お前の問題は、焦りが自分を特別にすると思い込んでることだ。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L018", "speaker_id": "sato", "text": "プライドは、音を立てる。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L019", "speaker_id": "sato", "text": "だが、力は——その必要がない。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L020", "speaker_id": "sato", "text": "次に警察をここへ連れてきたら、指を一本もらう。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L021", "speaker_id": "sato", "text": "俺が必要だからじゃない。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L022", "speaker_id": "sato", "text": "お前に、必要だからだ。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L023", "speaker_id": "sato", "text": "もう行け。" },
  { "scene": "07_SATO_AND_TANK", "line_id": "E01_S07_L024", "speaker_id": "sato", "text": "……静かにな。" },

  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L001", "speaker_id": "ren_vo", "text": "機械なんて、しょっちゅう狂ってる。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L002", "speaker_id": "ren", "text": "くそ……頼む、動け。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L003", "speaker_id": "ren_vo", "text": "機械は、諦める。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L004", "speaker_id": "ren_vo", "text": "人間も、諦める。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L005", "speaker_id": "ren_vo", "text": "だが、俺は諦めない。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L006", "speaker_id": "mentor", "text": "これ、君のだろ?" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L007", "speaker_id": "ren", "text": "それ、どこで手に入れた?" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L008", "speaker_id": "mentor", "text": "落としたよ。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L009", "speaker_id": "ren", "text": "金なら、持ってけ。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L010", "speaker_id": "mentor", "text": "金なんて、入ってないよ。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L011", "speaker_id": "ren", "text": "じゃあ、なんで追ってきた?" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L012", "speaker_id": "mentor", "text": "君は、死んでいてもおかしくなかった。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L013", "speaker_id": "ren", "text": "……よく言われるよ。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L014", "speaker_id": "mentor", "text": "いや。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L015", "speaker_id": "mentor", "text": "そうじゃない。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L016", "speaker_id": "ren", "text": "あんた、誰だ?" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L017", "speaker_id": "mentor", "text": "“止まれ”と言われた、ただの人間だ。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L018", "speaker_id": "ren", "text": "誰に、だ?" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L019", "speaker_id": "mentor", "text": "君は、もう分かってるはずだ。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L020", "speaker_id": "ren", "text": "財布と説教のために、雨ん中を歩いてきたのか?" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L021", "speaker_id": "mentor", "text": "いや。" },
  { "scene": "08_THE_LIE_AND_THE_WALLET", "line_id": "E01_S08_L022", "speaker_id": "mentor", "text": "雨の中を歩いてきたのは……今夜が、君が“自分は不死身じゃない”と悟りかけた、初めての夜だったからだ。" },

  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L001", "speaker_id": "ren", "text": "触るな。" },
  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L002", "speaker_id": "mentor", "text": "なら、聞いてくれ。" },
  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L003", "speaker_id": "mentor", "text": "イエス・キリストよ——" },
  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L004", "speaker_id": "mentor", "text": "闇がこいつに、恵みを“自分の腕”だと思い込ませる前に……どうか、その目を開いてください。" },
  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L005", "speaker_id": "reina", "text": "帰ってらっしゃい、レン。" },
  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L006", "speaker_id": "reina", "text": "あなたの父親の神に、これ以上わたくしから奪われる前に。" },
  { "scene": "09_THE_PRAYER_AND_THE_CALL", "line_id": "E01_S09_L007", "speaker_id": "ren", "text": "親父は……もう、死んだはずだ。" },

  { "scene": "10_POST_CREDIT", "line_id": "E01_S10_L001", "speaker_id": "guard", "text": "キサラギ。" },
  { "scene": "10_POST_CREDIT", "line_id": "E01_S10_L002", "speaker_id": "guard", "text": "面会だ。" },
  { "scene": "10_POST_CREDIT", "line_id": "E01_S10_L003", "speaker_id": "daisuke", "text": "誰が?" },
  { "scene": "10_POST_CREDIT", "line_id": "E01_S10_L004", "speaker_id": "guard", "text": "……奥さんだ。" }
]
