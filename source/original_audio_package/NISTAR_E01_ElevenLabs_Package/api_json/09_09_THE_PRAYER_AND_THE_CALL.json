[
  {
    "line_id": "E01_S09_L001",
    "speaker_id": "ren",
    "text": "[sharply] Don't touch me."
  },
  {
    "line_id": "E01_S09_L002",
    "speaker_id": "mentor",
    "text": "Then listen."
  },
  {
    "line_id": "E01_S09_L003",
    "speaker_id": "mentor",
    "text": "[calm, direct prayer] Jesus Christ\u2014"
  },
  {
    "line_id": "E01_S09_L004",
    "speaker_id": "mentor",
    "text": "Open his eyes before the darkness teaches him to call mercy skill."
  },
  {
    "line_id": "E01_S09_L005",
    "speaker_id": "reina",
    "text": "[through the phone, intimate and controlled] Come home, Ren."
  },
  {
    "line_id": "E01_S09_L006",
    "speaker_id": "reina",
    "text": "Before your father's God takes anything else from me."
  },
  {
    "line_id": "E01_S09_L007",
    "speaker_id": "ren",
    "text": "[stunned, barely audible] My father is dead."
  }
]