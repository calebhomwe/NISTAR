[
  {
    "line_id": "E01_S07_L001",
    "speaker_id": "sato",
    "text": "You are late."
  },
  {
    "line_id": "E01_S07_L002",
    "speaker_id": "ren",
    "text": "I'm here."
  },
  {
    "line_id": "E01_S07_L003",
    "speaker_id": "sato",
    "text": "That was not the accusation."
  },
  {
    "line_id": "E01_S07_L004",
    "speaker_id": "ren",
    "text": "[confused] What is that?"
  },
  {
    "line_id": "E01_S07_L005",
    "speaker_id": "sato",
    "text": "Tank."
  },
  {
    "line_id": "E01_S07_L006",
    "speaker_id": "ren",
    "text": "Tank?"
  },
  {
    "line_id": "E01_S07_L007",
    "speaker_id": "sato",
    "text": "He got out."
  },
  {
    "line_id": "E01_S07_L008",
    "speaker_id": "ren",
    "text": "You called me across the city for a dog?"
  },
  {
    "line_id": "E01_S07_L009",
    "speaker_id": "sato",
    "text": "I called you because he was missing."
  },
  {
    "line_id": "E01_S07_L010",
    "speaker_id": "ren",
    "text": "I had police behind me."
  },
  {
    "line_id": "E01_S07_L011",
    "speaker_id": "sato",
    "text": "Yes."
  },
  {
    "line_id": "E01_S07_L012",
    "speaker_id": "sato",
    "text": "You crossed half the city like God Himself was chasing you."
  },
  {
    "line_id": "E01_S07_L013",
    "speaker_id": "sato",
    "text": "[after a beat] For a dog."
  },
  {
    "line_id": "E01_S07_L014",
    "speaker_id": "ren",
    "text": "You said it was urgent."
  },
  {
    "line_id": "E01_S07_L015",
    "speaker_id": "sato",
    "text": "It was urgent to me."
  },
  {
    "line_id": "E01_S07_L016",
    "speaker_id": "sato",
    "text": "Your problem is not lateness."
  },
  {
    "line_id": "E01_S07_L017",
    "speaker_id": "sato",
    "text": "Your problem is that you think urgency makes you important."
  },
  {
    "line_id": "E01_S07_L018",
    "speaker_id": "sato",
    "text": "[quietly] Pride makes noise."
  },
  {
    "line_id": "E01_S07_L019",
    "speaker_id": "sato",
    "text": "Power does not have to."
  },
  {
    "line_id": "E01_S07_L020",
    "speaker_id": "sato",
    "text": "Next time you bring police to my door, I take a finger."
  },
  {
    "line_id": "E01_S07_L021",
    "speaker_id": "sato",
    "text": "Not because I need it."
  },
  {
    "line_id": "E01_S07_L022",
    "speaker_id": "sato",
    "text": "Because you do."
  },
  {
    "line_id": "E01_S07_L023",
    "speaker_id": "sato",
    "text": "Now leave."
  },
  {
    "line_id": "E01_S07_L024",
    "speaker_id": "sato",
    "text": "[lower and colder] Quietly."
  }
]