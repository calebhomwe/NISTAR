[
  {
    "line_id": "E01_S05_L001",
    "speaker_id": "ren",
    "text": "[low, impatient] Move."
  },
  {
    "line_id": "E01_S05_L002",
    "speaker_id": "ren",
    "text": "[shouts] No\u2014"
  },
  {
    "line_id": "E01_S05_L003",
    "speaker_id": "ren",
    "text": "[stunned] What\u2014"
  },
  {
    "line_id": "E01_S05_L004",
    "speaker_id": "guardian",
    "text": "[exhausted, almost a whisper] Again."
  },
  {
    "line_id": "E01_S05_L005",
    "speaker_id": "ren",
    "text": "[breathes shakily, then laughs once] Still got it."
  },
  {
    "line_id": "E01_S05_L006",
    "speaker_id": "daisuke",
    "text": "[softly] Thank You."
  },
  {
    "line_id": "E01_S05_L007",
    "speaker_id": "reflection",
    "text": "[whispers] Run."
  },
  {
    "line_id": "E01_S05_L008",
    "speaker_id": "ren",
    "text": "[adrenaline rising] You want a show?"
  }
