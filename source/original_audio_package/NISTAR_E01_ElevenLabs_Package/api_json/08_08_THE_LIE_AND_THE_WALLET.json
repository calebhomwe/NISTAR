[
  {
    "line_id": "E01_S08_L001",
    "speaker_id": "ren_vo",
    "text": "Machines are wrong all the time."
  },
  {
    "line_id": "E01_S08_L002",
    "speaker_id": "ren",
    "text": "[frustrated] Come on."
  },
  {
    "line_id": "E01_S08_L003",
    "speaker_id": "ren_vo",
    "text": "Machines give up."
  },
  {
    "line_id": "E01_S08_L004",
    "speaker_id": "ren_vo",
    "text": "People give up."
  },
  {
    "line_id": "E01_S08_L005",
    "speaker_id": "ren_vo",
    "text": "[with absolute certainty] I don't."
  },
  {
    "line_id": "E01_S08_L006",
    "speaker_id": "mentor",
    "text": "This yours?"
  },
  {
    "line_id": "E01_S08_L007",
    "speaker_id": "ren",
    "text": "Where did you get that?"
  },
  {
    "line_id": "E01_S08_L008",
    "speaker_id": "mentor",
    "text": "You dropped it."
  },
  {
    "line_id": "E01_S08_L009",
    "speaker_id": "ren",
    "text": "Take the money."
  },
  {
    "line_id": "E01_S08_L010",
    "speaker_id": "mentor",
    "text": "There isn't any."
  },
  {
    "line_id": "E01_S08_L011",
    "speaker_id": "ren",
    "text": "Then why follow me?"
  },
  {
    "line_id": "E01_S08_L012",
    "speaker_id": "mentor",
    "text": "You should be dead."
  },
  {
    "line_id": "E01_S08_L013",
    "speaker_id": "ren",
    "text": "[dryly] I get that a lot."
  },
  {
    "line_id": "E01_S08_L014",
    "speaker_id": "mentor",
    "text": "No."
  },
  {
    "line_id": "E01_S08_L015",
    "speaker_id": "mentor",
    "text": "You don't."
  },
  {
    "line_id": "E01_S08_L016",
    "speaker_id": "ren",
    "text": "Who are you?"
  },
  {
    "line_id": "E01_S08_L017",
    "speaker_id": "mentor",
    "text": "Someone who was told to stop."
  },
  {
    "line_id": "E01_S08_L018",
    "speaker_id": "ren",
    "text": "By who?"
  },
  {
    "line_id": "E01_S08_L019",
    "speaker_id": "mentor",
    "text": "[quietly] You already know."
  },
  {
    "line_id": "E01_S08_L020",
    "speaker_id": "ren",
    "text": "You walked through rain for a wallet and a sermon?"
  },
  {
    "line_id": "E01_S08_L021",
    "speaker_id": "mentor",
    "text": "No."
  },
  {
    "line_id": "E01_S08_L022",
    "speaker_id": "mentor",
    "text": "I walked through rain because tonight was the closest you have ever come to understanding that you are not immortal."
  }
]