[
  {
    "line_id": "E01_S02_L001",
    "speaker_id": "daisuke",
    "text": "[gasps] Jesus\u2014"
  },
  {
    "line_id": "E01_S02_L002",
    "speaker_id": "daisuke",
    "text": "[breathing shakily] I don't know where my son is."
  },
  {
    "line_id": "E01_S02_L003",
    "speaker_id": "daisuke",
    "text": "But You do."
  },
  {
    "line_id": "E01_S02_L004",
    "speaker_id": "daisuke",
    "text": "[quietly, with urgency] Don't let the lie he calls strength kill him."
  },
  {
    "line_id": "E01_S02_L005",
    "speaker_id": "ren",
    "text": "[gasps sharply]"
  },
  {
    "line_id": "E01_S02_L006",
    "speaker_id": "ren",
    "text": "[hoarse] Yeah."
  },
  {
    "line_id": "E01_S02_L007",
    "speaker_id": "sato",
    "text": "[coldly] You are late."
  },
  {
    "line_id": "E01_S02_L008",
    "speaker_id": "ren",
    "text": "I'm at home."
  },
  {
    "line_id": "E01_S02_L009",
    "speaker_id": "sato",
    "text": "Not anymore."
  },
  {
    "line_id": "E01_S02_L010",
    "speaker_id": "ren",
    "text": "What happened?"
  },
  {
    "line_id": "E01_S02_L011",
    "speaker_id": "sato",
    "text": "Arrive first. Ask questions second."
  },
  {
    "line_id": "E01_S02_L012",
    "speaker_id": "ren",
    "text": "Sato\u2014"
  },
  {
    "line_id": "E01_S02_L013",
    "speaker_id": "sato",
    "text": "And Ren?"
  },
  {
    "line_id": "E01_S02_L014",
    "speaker_id": "sato",
    "text": "[after a short pause] You were already late before the phone rang."
  }
]