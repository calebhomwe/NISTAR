[
  {
    "line_id": "E01_S04_L001",
    "speaker_id": "associate",
    "text": "Was that him?"
  },
  {
    "line_id": "E01_S04_L002",
    "speaker_id": "reina",
    "text": "[calmly] No."
  },
  {
    "line_id": "E01_S04_L003",
    "speaker_id": "reina",
    "text": "Something reached for him."
  },
  {
    "line_id": "E01_S04_L004",
    "speaker_id": "associate",
    "text": "Your people?"
  },
  {
    "line_id": "E01_S04_L005",
    "speaker_id": "reina",
    "text": "[a faint amused breath] My people do not pray."
  },
  {
    "line_id": "E01_S04_L006",
    "speaker_id": "reina",
    "text": "[quietly] Find out who did."
  }
]